# ==============================================================================
# InteriorAI Studio Frontend - Environment Configuration
# Firebase Web Client Configuration & Backend API URL
# ==============================================================================

# Backend API Base URL
VITE_BACKEND_URL=http://localhost:8080

# Firebase Client Web SDK Config
# Replace with your Firebase Web App configuration from Firebase Console:
# Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=AIzaSyDemoKeyInteriorAiStudioClient
VITE_FIREBASE_AUTH_DOMAIN=interiorai-studio.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=interiorai-studio
VITE_FIREBASE_STORAGE_BUCKET=interiorai-studio.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# OpenRouter API Key (from https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Hugging Face Access Token (from https://huggingface.co/settings/tokens)
HF_TOKEN=hf_your_token_here
