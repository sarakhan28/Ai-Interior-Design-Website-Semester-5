# ==============================================================================
# InteriorAI Studio Backend - Environment Configuration Template
# Copy this file to .env or configure your system environment variables.
# NEVER commit real Firebase private keys or credentials to version control.
# ==============================================================================

# Server Port
PORT=8080

# Firebase Admin SDK Configuration
# Option 1: Absolute or relative path to serviceAccountKey.json
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json

# Option 2: Full raw JSON string of serviceAccountKey.json (useful for containerized/cloud deployments)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"interiorai-studio",...}

# Firebase Cloud Storage Bucket Name (found in Firebase Console -> Storage)
FIREBASE_STORAGE_BUCKET=interiorai-studio.appspot.com

# Set to false in production to enforce genuine Firebase token verification
# Set to true for local testing without Firebase credentials
FIREBASE_MOCK_ENABLED=true

# Allowed CORS Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
